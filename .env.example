# CloudForge — Environment Variables (all optional, safe defaults)
# Copy to .env.local for local development. NEVER commit real secrets.

# --- Next.js / Platform ---
NEXT_PUBLIC_APP_NAME=CloudForge
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (PostgreSQL + Auth + Realtime + Edge Functions) ---
# Project URL: https://app.supabase.com/project/<ref>/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI Providers (used by Edge Functions / /api/ai routes) ---
# At least one is needed for real AI generation; without any, the app
# falls back to deterministic template-based generation so it never breaks.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Payments ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Crypto payments (Coinbase Commerce / custom)
CRYPTO_WEBHOOK_SECRET=

# --- Monitoring ---
NEXT_PUBLIC_SENTRY_DSN=

# --- Deploy tokens (GitHub Actions only, stored as GitHub Secrets) ---
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
# NETLIFY_AUTH_TOKEN=
# NETLIFY_SITE_ID=

# --- Stripe catalog prices (server-side only) ---
# Pro subscription prices: $20 monthly, annual price should encode the approved discount.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# One-time ad workflow credit products.
STRIPE_PRICE_AD_ENGINE=
STRIPE_PRICE_AD_STARTER=
STRIPE_PRICE_AD_GROWTH=
STRIPE_PRICE_AD_SCALE=
# Keep false in every production environment. Sandbox is opt-in for local development.
ALLOW_SANDBOX_CHECKOUT=false

# --- Additional payment providers (server-side only; integrations must verify webhooks) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
BINANCE_PAY_API_KEY=
BINANCE_PAY_SECRET_KEY=
BINANCE_PAY_WEBHOOK_SECRET=
# Apple Pay is presented through Stripe Checkout's wallet support; no wallet secret belongs in the browser.
